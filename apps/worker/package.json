{
  "name": "worker",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "echo 'ERROR: 環境を明示してください → pnpm run deploy:dev / deploy:prod (prodはVITE_LIFF_ID/VITE_BOT_BASIC_IDを本番値で)' && exit 1",
    "deploy:dev": "vite build && wrangler deploy --config dist/line_harness/wrangler.json",
    "deploy:prod": "CLOUDFLARE_ENV=prod vite build && wrangler deploy --config dist/line_harness/wrangler.json",
    "typecheck": "tsc --noEmit",
    "inject-version": "tsx scripts/inject-version.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@line-crm/db": "workspace:*",
    "@line-crm/line-sdk": "workspace:*",
    "@line-crm/shared": "workspace:*",
    "@line-harness/update-engine": "workspace:*",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  }
}